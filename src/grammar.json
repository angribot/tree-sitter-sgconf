    "directive": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*#![^\\r\\n]*"
        }
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*(?:#[^\\r\\n]*|;[^\\r\\n]*|\\/\\/[^\\r\\n]*)"
        }
      }
    },
    "unknown_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*[^\\x5b\\r\\n \\t][^\\r\\n]*"
        }
      }
    },
